# Copy to .env.local for local work (or run `vercel env pull .env.local`). Never commit real values.

# Neon Postgres connection string. Production uses the main database, Preview and Development the "dev" branch.
DATABASE_URL=

# Long random string. Opening <APP_URL>/owner/<OWNER_LINK_SECRET> gives that device manage access to every group.
OWNER_LINK_SECRET=

# The app's public address, without a trailing slash, e.g. https://secret-santa.vercel.app
APP_URL=
